package_options = {
    "high_barrier_laminate": 0.01,
    "medium_barrier_pouch": 0.10,
    "basic_polymer_bag": 1.00
}

for package_name, package_WVTR in package_options.items():
    summary, _ = simulate_hemp_protein_package(
        temperature,
